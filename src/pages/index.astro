---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts, getWorks } from '../lib/posts';
import { SITE } from '../site';
import { getEntry, render } from 'astro:content';

const home = (await getEntry('pages', 'home'))!;
const { Content: Intro } = await render(home);

const posts = (await getPosts()).slice(0, 5);
const works = (await getWorks()).slice(0, 3);
---
<Base>
  <p class="intro">{home.data.tagline ?? SITE.tagline}</p>
  <div class="intro-body"><Intro /></div>

  <h2 class="section-label">최근 글</h2>
  {posts.length ? <PostList posts={posts} /> : <p class="meta">아직 글이 없습니다.</p>}
  <a class="more" href="/writing/">모든 글 →</a>

  {works.length > 0 && (
    <>
      <h2 class="section-label">최근 작업</h2>
      <ul class="list">
        {works.map((w) => (
          <li>
            <a href={`/work/${w.id}/`}>{w.data.title}</a>
            <span class="meta">{w.data.kind} · {w.data.date.getFullYear()}</span>
          </li>
        ))}
      </ul>
      <a class="more" href="/work/">모든 작업 →</a>
    </>
  )}
</Base>
