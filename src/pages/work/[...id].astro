---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getWorks, fmtDate, isoDate } from '../../lib/posts';
import { embedHtml } from '../../../integrations/embeds.mjs';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work) => ({ params: { id: work.id }, props: { work } }));
}

const { work } = Astro.props;
const { Content } = await render(work);
const d = work.data;
// '외부 링크'가 SoundCloud·YouTube면 본문 위에 플레이어 표시 (본문에 같은 주소를 또 넣었으면 생략)
const player = d.link && !work.body?.includes(d.link.split('?')[0]) ? embedHtml(d.link) : null;
---
<Base title={d.title} description={d.description} image={d.cover} type="article" date={d.date}>
  <article data-pagefind-body>
    <header class="post-head">
      <h1>{d.title}</h1>
      <p class="meta">
        <a href="/work/">{d.kind}</a> · <time datetime={isoDate(d.date)}>{fmtDate(d.date)}</time>
        {d.link && <> · <a href={d.link} rel="noopener">원본 링크</a></>}
      </p>
    </header>
    {d.cover && <figure class="cover"><img src={d.cover} alt="" /></figure>}
    {player && <Fragment set:html={player} />}
    <div class="prose"><Content /></div>
  </article>
</Base>
