---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getWorks, fmtDate, isoDate } from '../../lib/posts';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work) => ({ params: { id: work.id }, props: { work } }));
}

const { work } = Astro.props;
const { Content } = await render(work);
const d = work.data;
---
<Base title={d.title} description={d.description} image={d.cover} type="article" date={d.date}>
  <article data-pagefind-body>
    <header class="post-head">
      <h1>{d.title}</h1>
      <p class="meta">
        <a href="/work/">{d.kind}</a> · <time datetime={isoDate(d.date)}>{fmtDate(d.date)}</time>
        {d.link && <> · <a href={d.link} rel="noopener">원본 링크</a></>}
      </p>
    </header>
    {d.cover && <figure class="cover"><img src={d.cover} alt="" /></figure>}
    <div class="prose"><Content /></div>
  </article>
</Base>
